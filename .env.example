# ---- Frontend (public — bundled into the browser; NEVER put secrets here) ----
VITE_API_URL=http://localhost:3000            # API origin, no /api/v1 suffix
VITE_SUPABASE_URL=http://127.0.0.1:54321      # must equal SUPABASE_URL below
VITE_SUPABASE_ANON_KEY=                       # anon/publishable key from `supabase status`

# ---- Supabase (backend) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=                            # anon/publishable key from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=                    # service_role/secret key from `supabase status` — backend only, never expose to the browser

# ---- AI ----
AI_PROVIDER=anthropic                         # anthropic | openai
AI_MODEL=                                     # model id for the chosen provider, e.g. claude-sonnet-4-5 or gpt-4o
AI_API_KEY=                                   # provider API key — backend only

# ---- API (optional, defaults shown) ----
# PORT=3000
# NODE_ENV=development
# LOG_LEVEL=info
# CORS_ORIGIN=http://localhost:5173           # comma-separated for multiple origins
# TRUST_PROXY=false                           # set to 1 behind a single proxy hop
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
